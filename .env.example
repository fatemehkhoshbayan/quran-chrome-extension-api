# Quran Foundation Content API (https://api-docs.quran.foundation/request-access)
CLIENT_ID=
CLIENT_SECRET=

# Chrome extension: 32-char ID from the Chrome Web Store URL (last path segment) or chrome://extensions
# Production (Daily Quran): diilngbfimlnkdbabjhadnblkhfbfcge
# Multiple IDs (unpacked dev + Store): EXTENSION_ID=id1,id2
EXTENSION_ID=diilngbfimlnkdbabjhadnblkhfbfcge
EXTENSION_SECRET=

# Gemini (set GEMINI_API_KEY in Vercel → Environment Variables for Production)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# TAFSIR_OPENROUTER_FIRST=true
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Exact redirect URI registered with Quran Foundation for the callback:
# QF_USER_REDIRECT_URI=https://quran-chrome-extension-api.vercel.app/auth/quran/callback
# For local dev use: 
QF_USER_REDIRECT_URI=http://localhost:3000/auth/quran/callback

QF_USER_AUTH_BASE_URL=https://oauth2.quran.foundation
QF_USER_API_BASE_URL=https://apis.quran.foundation/auth

# Random secret used to sign/opaque session IDs stored in Redis (min 32 chars):
APP_SESSION_SECRET=

# Upstash Redis (https://console.upstash.com → create free database → REST API):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=